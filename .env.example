# Copy this file to .env for local configuration. Commit .env.example only.
# The default demo needs no AWS credentials and never calls AWS or a model.
SCENEBRIDGE_MODE=fixture
HOST=127.0.0.1
PORT=3000

# Optional AWS mode: configure your AWS login locally, uncomment the settings
# below as needed, prepare the content, then change SCENEBRIDGE_MODE to aws.
# AWS integrations are implemented but have not been verified live.
# Credentials come from the AWS SDK credential chain; do not put keys here.
# AWS_REGION=us-east-1
# AWS_PROFILE=scenebridge
# BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# S3_BUCKET=your-private-bucket-name
# S3_PREFIX=scenebridge

# Inference limits apply in AWS mode. They are not a cloud spending cap.
# The request counter resets when the server process restarts.
MAX_MODEL_REQUESTS=100
MAX_QUESTION_CHARS=600
MODEL_TIMEOUT_MS=20000
MODEL_MAX_OUTPUT_TOKENS=600

# Optional: point the SDK at ignored local AWS profile files.
# AWS_SHARED_CREDENTIALS_FILE=/absolute/path/to/.local/aws/credentials
# AWS_CONFIG_FILE=/absolute/path/to/.local/aws/config
